{
  "_说明": "本仓库作者实际运行的 AstrBot 主配置的脱敏模板：保留全部调校参数（限流、真人感分段回复、白名单策略、语音接线等），仅把密钥与个人信息替换为 <占位符>。用法：全新安装可直接把本文件覆盖到 local/astrbot_data/cmd_config.json 后改占位符并重启容器；也可以在面板里逐项对照修改。生成时间 2026-10。",
  "_必改占位符": "共 8 类 11 处（key×2、模型名、Embedding×3、GSVI角色名、人格名、QQ号、面板用户名、WS token）。漏改后果：API Key 类 → 无法对话；<你的QQ号>（admins_id）→ 白名单开启状态下机器人对所有人（包括你自己）沉默，症状像'配置坏了'其实是占位符没换；模型名 → 报模型不存在；<你的人格名> → 人格不生效；Embedding 三项 → 记忆不工作。全部改完后建议全局搜索 '<' 确认无残留。",
  "_重要顺序": "本文件所有以 _ 开头的说明键，在 AstrBot 首次启动加载时会被自动清除并重写排序——务必先改完全部占位符、再启动容器。本模板为精简版，缺失键 AstrBot 会自动补默认值；若面板某功能异常，对照面板当前配置补回对应字段即可。另：dashboard.password 留空依赖 v4.25+ 的随机密码机制（打印在首启日志里，仅一次），本仓库 compose 已钉 v4.28.2。",
  "config_version": 2,
  "platform_settings": {
    "unique_session": false,
    "rate_limit": { "time": 30, "count": 10, "strategy": "stall" },
    "reply_prefix": "",
    "forward_threshold": 1500,
    "enable_id_white_list": true,
    "id_whitelist": [],
    "id_whitelist_log": true,
    "wl_ignore_admin_on_group": true,
    "wl_ignore_admin_on_friend": true,
    "reply_with_mention": false,
    "reply_with_quote": false,
    "path_mapping": [],
    "segmented_reply": {
      "enable": true,
      "only_llm_result": true,
      "interval_method": "random",
      "interval": "1.5,3.5",
      "log_base": 2.6,
      "words_count_threshold": 100,
      "split_mode": "regex",
      "regex": "[^\\n]+?[？！…]|[^\\n]+",
      "split_words": ["。", "？", "！", "~", "…"],
      "content_cleanup_rule": ""
    },
    "no_permission_reply": true,
    "empty_mention_waiting": true,
    "empty_mention_waiting_need_reply": true,
    "friend_message_needs_wake_prefix": false,
    "ignore_bot_self_message": false,
    "ignore_at_all": false
  },
  "_说明_provider_sources": "两个 LLM 服务源示例：DeepSeek 官方 + 火山方舟(豆包)。任选其一即可，key 换成你自己的",
  "provider_sources": [
    {
      "provider": "deepseek",
      "type": "openai_chat_completion",
      "provider_type": "chat_completion",
      "key": ["<你的DeepSeek APIKey>"],
      "api_base": "https://api.deepseek.com/v1",
      "timeout": 120,
      "proxy": "",
      "custom_headers": {},
      "id": "deepseek",
      "enable": true
    },
    {
      "provider": "volcengine",
      "type": "openai_chat_completion",
      "provider_type": "chat_completion",
      "key": ["<你的火山方舟APIKey>"],
      "api_base": "https://ark.cn-beijing.volces.com/api/v3",
      "timeout": 120,
      "proxy": "",
      "custom_headers": {},
      "id": "doubao",
      "enable": true
    }
  ],
  "_说明_provider": "在服务源下启用的具体模型：作者用的是 lite 级（快、便宜、日常聊天够用），追求更好口吻可开 pro",
  "provider": [
    {
      "id": "doubao/doubao-seed-2-0-lite",
      "enable": true,
      "provider_source_id": "doubao",
      "model": "<具体模型名，如 doubao-seed-2-0-lite-260215>",
      "modalities": ["text"],
      "custom_extra_body": {},
      "max_context_tokens": 256000
    },
    {
      "id": "deepseek/deepseek-chat",
      "enable": false,
      "provider_source_id": "deepseek",
      "model": "deepseek-chat",
      "modalities": ["text", "tool_use"],
      "custom_extra_body": {},
      "max_context_tokens": 128000
    },
    {
      "_说明": "记忆插件(mnemosyne)必需的 Embedding 模型，维度按所选模型填（bge-m3=1024，火山方舟部分型号=2048）",
      "id": "my_embedding",
      "type": "openai_embedding",
      "provider": "volcengine",
      "provider_type": "embedding",
      "enable": true,
      "embedding_api_key": "<你的Embedding服务APIKey>",
      "embedding_api_base": "<你的Embedding服务地址>",
      "embedding_model": "<你的Embedding模型/接入点>",
      "embedding_dimensions": 2048,
      "timeout": 20,
      "proxy": ""
    },
    {
      "_说明": "GPT-SoVITS 语音：类型必须用 gsv_tts_selfhost（走 GET /tts，与 GSVI 推理包匹配）。切勿用 gsvi_tts_api——它调用的 /infer_single 端点 GSVI 推理包并不存在，语音会静默不响。api_base 固定 host.docker.internal:5000（容器访问宿主机）",
      "id": "gsvi_tts",
      "type": "gsv_tts_selfhost",
      "provider": "gpt_sovits_inference",
      "provider_type": "text_to_speech",
      "enable": true,
      "api_base": "http://host.docker.internal:5000",
      "gsv_default_parms": {
        "gsv_character": "<你的GSVI角色名>",
        "gsv_emotion": "default",
        "gsv_text_lang": "中文"
      },
      "timeout": 60
    }
  ],
  "provider_settings": {
    "enable": true,
    "default_provider_id": "",
    "fallback_chat_models": [],
    "wake_prefix": "",
    "web_search": false,
    "web_search_link": false,
    "display_reasoning_text": false,
    "identifier": false,
    "group_name_display": false,
    "datetime_system_prompt": true,
    "default_personality": "<你的人格名，与人格页一致>",
    "prompt_prefix": "{{prompt}}",
    "context_limit_reached_strategy": "truncate_by_turns",
    "max_context_length": -1,
    "dequeue_context_length": 1,
    "streaming_response": true,
    "proactive_capability": { "add_cron_tools": true },
    "llm_safety_mode": false,
    "image_compress_enabled": true,
    "image_compress_options": { "max_size": 1280, "quality": 95 }
  },
  "provider_stt_settings": { "enable": false, "provider_id": "" },
  "_说明_tts": "dual_output=true 表示同一条回复 文字+语音 都发（推荐：语音后端挂了至少还有文字）；只想要语音就改 false",
  "provider_tts_settings": {
    "enable": true,
    "provider_id": "gsvi_tts",
    "dual_output": true,
    "use_file_service": false,
    "trigger_probability": 1.0
  },
  "provider_ltm_settings": {
    "group_icl_enable": false,
    "group_message_max_cnt": 300,
    "image_caption": false,
    "image_caption_provider_id": "",
    "active_reply": { "enable": false, "method": "possibility_reply", "possibility_reply": 0.1, "whitelist": [] }
  },
  "_说明_admins": "把你的常用QQ填这里：既是管理员，也是唯一能跟她聊的人（配合上面开启的白名单+管理员豁免）",
  "admins_id": ["<你的QQ号>"],
  "t2i": true,
  "t2i_word_threshold": 150,
  "t2i_strategy": "remote",
  "t2i_endpoint": "",
  "t2i_use_file_service": false,
  "t2i_active_template": "base",
  "http_proxy": "",
  "no_proxy": ["localhost", "127.0.0.1", "::1", "10.*", "192.168.*"],
  "_说明_dashboard": "username 填你想要的；password/jwt_secret 留空，AstrBot 首次启动会自动生成并打印在日志里",
  "dashboard": {
    "enable": true,
    "username": "<面板用户名>",
    "password": "",
    "jwt_secret": "",
    "host": "0.0.0.0",
    "port": 6185,
    "disable_access_log": true,
    "ssl": { "enable": false, "cert_file": "", "key_file": "", "ca_certs": "" }
  },
  "_说明_platform": "OneBot 反向 WS 服务端：token 自拟一个，同样的值填到 NapCat 网络配置的 WebSocket 客户端里",
  "platform": [
    {
      "id": "aiocqhttp",
      "type": "aiocqhttp",
      "enable": true,
      "ws_reverse_host": "0.0.0.0",
      "ws_reverse_port": 6199,
      "ws_reverse_token": "<自拟WS token，与NapCat一致>"
    }
  ],
  "wake_prefix": ["/"],
  "log_level": "INFO",
  "log_file_enable": false,
  "log_file_path": "logs/astrbot.log",
  "log_file_max_mb": 20,
  "temp_dir_max_size": 1024,
  "pip_install_arg": "",
  "pypi_index_url": "https://mirrors.aliyun.com/pypi/simple/",
  "persona": [],
  "timezone": "Asia/Shanghai",
  "callback_api_base": "",
  "default_kb_collection": "",
  "plugin_set": ["*"]
}
