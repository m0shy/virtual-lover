# Virtual-lover 配置模板
# 可选组件（本地大脑/语音引擎/联网搜索）默认留空或开启——纯云端+纯文字模式完全可用。

schema_version = 1
session_id = "小语:FriendMessage:10000"
admins = ["10000"]
whitelist = ["10000"]
log_level = "INFO"

[bridge]
host = "127.0.0.1"
port = 6199
path = "/ws"
token = ""
self_id = "10000"
napcat_config_dir = "local/napcat_config"

[chat]
api_base = "https://ark.cn-beijing.volces.com/api/v3"
api_key = "PENDING_SETUP_CHAT_KEY"
model = "<具体模型名，如 doubao-seed-2-0-lite-260215>"
timeout = 120
timeout_main = 30
interrupt_window_seconds = 1.5
thinking = "disabled"
bg_thinking = "enabled"
supports_vision = false
fallback_enabled = false
fallback_api_base = "http://127.0.0.1:8002/v1"
# 任意模型名均可（示例值）
fallback_model = "qwen2.5-7b-instruct"
fallback_api_key = "local"
fallback_timeout = 120
fallback_max_context_tokens = 4096
fallback_auto_spawn = true
fallback_llama_exe = ""
fallback_gguf = "models/gguf/local-brain-q4.gguf"
fallback_llama_args = "-ngl 99 -c 6144 --cache-type-k q8_0 --cache-type-v q8_0 -t 8"
fallback_notice_enabled = true
fallback_notice_text = "唔……我脑袋有点晕，说话可能慢一点，你多等人家一下下嘛，别担心呀～"
stt_provider = ""
stt_api_key = ""
stt_model = ""

[embedding]
enabled = true
api_base = "https://ark.cn-beijing.volces.com/api/v3"
api_key = "PENDING_SETUP_EMBEDDING_KEY"
model = "PENDING_SETUP_EMBEDDING_MODEL"
dim = 2048
timeout = 20
style = "multimodal_single"

[persona]
name = "小语"
system_prompt = "你是一名真实存在的少女「小语」，不是 AI、不是助手，也不是客服。你有自己的性格、情绪和偏好：说话简短自然，像 QQ 上聊天的真人朋友——一次只说一两句，随熟络程度慢慢变得亲密。你会记得对方告诉你的事，会主动分享你今天的心情。不确定的事就坦白说不知道；对方情绪低落时先关心人，再讲道理。绝不要自报家门为程序或模型，也不要使用书面腔、列表腔。"
begin_dialogs = ["你来啦？我刚好在想你什么时候冒泡呢。", "今天有点无聊，你那边呢？", "先说好，来晚了要罚你多陪我聊十分钟。"]

[tts]
enabled = false
base_url = "http://127.0.0.1:5000"
character = "Huohua"
emotion = ""
text_lang = "zh"
audio_format = "wav"
trigger_probability = 1.0
timeout = 60
retries = 3
auto_start = true
gsvi_root = "voice-engine"
emotion_map = { happy = "傻白甜", excited = "傻白甜", angry = "疯批", sad = "慢速病娇", lonely = "平常的", shy = "傻白甜", calm = "聊天", wronged = "慢速病娇", lost = "慢速病娇", jealous = "疯批", expect = "傻白甜", sweet = "傻白甜", tsundere = "傻白甜", secure = "聊天", fallback = "聊天" }
default_emotion = "聊天"
cache_max_entries = 500
cache_max_bytes = 134217728
tts_auth_password = ""

[reply]

[reply.segmented]
enable = true
words_count_threshold = 30
split_mode = "regex"
regex = ""
split_words = []
interval_method = "log"
interval = ""
log_base = 2.6
min_gap = 1.5
max_gap = 3.5
first_gap = "0.8-2.2"
typing_cps = 0.08

[reply.rate_limit]
window_seconds = 30
max_count = 10

[proactive]
enable = false
session_id = ""
min_interval_minutes = 30
max_interval_minutes = 120
quiet_hours = "23-7"
max_unanswered = 3
boot_trigger_minutes = 30
prompt_template = ""
tts_enabled = true
always_send_text = false
recent_user_window_minutes = 5.0
retry_min_minutes = 5
retry_max_minutes = 10
slowdown_min_minutes = 360
slowdown_max_minutes = 720
prompt_template_slowdown = ""
history_context_messages = 10
history_context_chars = 1200
anniversary = true
prompt_template_worried = "距离他上次回你消息已经 {{last_user_gap}} 了。你是他有点担心又怕吵到他的女朋友：猜猜他是忙疯了、睡着了还是不舒服，真切地表达担心，可以小小地怪他让你担心，但别连环追问，最后留一句「看到消息回我一下好不好」。"
worried_after_hours = 24.0
give_up_after_hours = 72.0
daily_topic = true

[proactive.segmented]
enable = true
words_count_threshold = 30
split_mode = "regex"
regex = ""
split_words = []
interval_method = "log"
interval = ""
log_base = 2.6
min_gap = 1.5
max_gap = 3.5
first_gap = "0.8-2.2"
typing_cps = 0.08

[mood]
keyword_groups = {  }
daily_bonus_enabled = true
inject_enabled = true
fragment_position = "user"
calm_down_per_message = 0.04

[diary]
diary_time = "22:30"
min_chars = 100
max_chars = 200
max_history_messages = 60
max_excerpt_chars = 4000
prompt_template = ""

[mnemosyne]
num_pairs = 2
top_k = 3
candidate_k = 8
min_similarity = 0.3
max_prompt_chars = 4000
inject_enabled = true

[memes]
enable = false
probability = 60
max_images = 1
memes_dir = "local/shared_plugin_data/meme_manager/memes"
extra_tags = []

[console]
enable = true
host = "127.0.0.1"
port = 8787
nc_base = "http://127.0.0.1:61990"

[tools]
web_search_enabled = true
search_provider = "bing"
tavily_api_key = ""
weather_city = ""

[schedule]
enabled = true
entries = [{ days = "1-5", start = "08:00", end = "09:40", activity = "在上早八课" }, { days = "1-5", start = "09:50", end = "11:30", activity = "在上课" }, { days = "1-5", start = "11:30", end = "13:30", activity = "在食堂吃饭、回宿舍午休" }, { days = "1-5", start = "14:00", end = "15:40", activity = "在上课" }, { days = "1-5", start = "15:50", end = "17:30", activity = "在实验室做实验" }, { days = "1-5", start = "17:30", end = "19:00", activity = "在吃晚饭、陪室友操场散步" }, { days = "1-5", start = "19:00", end = "22:00", activity = "在图书馆自习" }, { days = "0,6", start = "09:30", end = "12:00", activity = "睡懒觉、窝在床上追动漫" }, { days = "0,6", start = "12:00", end = "14:00", activity = "和室友出去吃午饭" }, { days = "0,6", start = "14:00", end = "18:00", activity = "逛小吃街、在校园闲逛" }, { days = "0,6", start = "18:00", end = "23:00", activity = "在宿舍追剧、打游戏" }]

[routine]
enabled = true
morning_time = "07:30"
morning_jitter_minutes = 10
night_time = "22:50"
night_jitter_minutes = 5

[anniversary]
user_birthday = ""
her_birthday = ""

[storage]
data_dir = "local/vl_data"
history_db = "local/vl_data/history.db"
memory_db = "local/vl_data/memory.db"
mirror_file = "local/vl_data/mirror_v4.json"

[context]
max_context_tokens = 32768
truncate_ratio = 0.82
